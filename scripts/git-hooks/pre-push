#!/bin/sh
# pre-push - POARTA pe push pentru acest repo.
#
# De ce exista: masurat 2026-10-11, 12 comituri au ajuns pe GitHub fara acordul
# lui Popy. Portile din script (-Acord) se ocolesc prin `git push` direct: un
# script impune o regula doar fata de cel care coopteaza. Asta nu e o poarta,
# e o cutie.
#
# Refuzul se face PE SERVER, nu se modifica nimic acolo. Se consuma un singur
# acord: un -Acord = o singura impingere.
#
# Scoaterea portii: git config --local --unset core.hooksPath
# (si stergerea acestui fisier). Nu se atinge nimic din interfata Popy.
#
# NOTA 2026-10-28: acest fisier a disparit de pe disk (cel mai probabil un
# `git clean` de control negativ in repo-ul backbone, unde hook-ul era
# neversionat). Consecinta: poarta de push a fost INEXISTENTA timp de cateva
# ore, iar doua push-uri au trecut fara niciun consum de acord. Fisierul a
# fost restaurat si versionat in backbone, ca un `git clean` sa nu-l mai
# poata sterge.
#
# NOTA 2026-10-28 (unificare SOT): masurat - versiunea cu NOTA de mai sus NU
# se gassea in istoricul niciunuia dintre ref-uri (git log --all -S 'NOTA
# 2026-10-28' -> gol; singurul commit pe aceasta cale era bf6997a, 883 octeti,
# fara NOTA). A fost recuperata din copia ramasa la
# projects\scripts\git-hooks\pre-push si a devenit varianta CANONICA.
# Acum exista un singur fisier al portii:
#   SOT\scripts\git-hooks\pre-push        <- varianta canonica (versionata)
#   SOT\.git\hooks\pre-push               <- copia instalata (activate)
#   projects\scripts\git-hooks\pre-push   <- junction spre varianta canonica
#
# Verificare ca poarta chiar opreste: creeaza fisierul PUSH-ACORD in
# .git\ si ruleaza `git push --dry-run`. Daca trece fara acord, poarta e
# decoratie, nu poarta.

marker="$(git rev-parse --git-dir)/PUSH-ACORD"
if [ -f "$marker" ]; then
  rm -f "$marker"
  exit 0
fi

echo ""
echo "  POARTA: acest repo nu se impinge fara acordul lui Popy."
echo "  Orice push direct e refuzat. Nu e o defectiune, e poarta."
echo "  Calea corecta:  scripts\git-autopush.ps1 -Acord"
echo ""
exit 1
