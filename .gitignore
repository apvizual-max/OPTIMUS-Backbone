scripts/_jtest/

# ── RUNTIME: se regenerează la fiecare pornire ─────────────────────────────
# live-state.json se rescrie ~la 40 s. Dacă ar intra în istorie, fiecare
# commit al meu ar fi o urmă de 83 KB de JSON măsurătoare, nu o schimbare.
*.log
*.pid
*.tmp
90_CONTROL_CENTER/api/live-state.json
90_CONTROL_CENTER/api/state-history.jsonl
# push-pending.json: starea peretelui de push, se rescrie la fiecare masuratoare.
# Daca ar intra in istorie, fiecare masuratoare ar face un comit nou.
90_CONTROL_CENTER/api/push-pending.json
90_CONTROL_CENTER/api/health-report.json
90_CONTROL_CENTER/api/cc-health.json
90_CONTROL_CENTER/api/nbask/
90_CONTROL_CENTER/api/ask/
90_CONTROL_CENTER/api/*-cache.json
90_CONTROL_CENTER/logs/
scratch/

# .log.before-fix / .PRE-* NU sunt excluse: sunt dovezi păstrate ale unor
# corectii. Stergerea lor din istorie ar sterge singura urma a corectiei.

# ── SECRETE ────────────────────────────────────────────────────────────────
# Nu au ce căuta aici. Dacă apar, se exclud — nu se comit niciodată.
#(token-uri Google OAuth găsite dezgolite într-un folder "~" lăsat de o
# comandă shell cu virgulă în loc de slash — vezi raportul)
.lrc.toml
*.env
.env
**/tokens/
~/

# ── DEPENDINȚE INSTALATE ───────────────────────────────────────────────────
node_modules/
__pycache__/
*.pyc

# ── STAREA RUNTIME DIN SENTINEL_PRIME: NU SE URMARESTE IN ISTORIC ──────────
# MASURAT 2026-10-28: aceste fisiere se rescriu continuu (serverul SENTINEL
# ruleaza pe 8912, motorul de self-improvement scrie la fiecare ciclu). In
# monorepo, un arbore pe care nu-l poti pastra curent nu e un arbore: fiecare
# commit ar ingropa o urma de stare, nu o schimbare.
#
# REGULA: fisierele RAMAN PE DISK, vizibile, si in istoricul de acum inainte
# (snapshot-urile raman in commit-uri). Ce se schimba: nu mai sunt urmarite.
# Nimic nu se sterge. Nimic nu se ascunde - exceptia e scrisa aici, cu motiv.
#
# Aceasta este o schimbare fata de .gitignore-ul propriu al SENTINEL_PRIME,
# care spune "nothing is excluded on purpose". Schimbarea e necesara pentru
# monorepo si e consemnata in mesajul de commit, nu aplicata in taceri.
SENTINEL_PRIME/09_LOGS/
SENTINEL_PRIME/13_COMMAND_CENTER/logs/
SENTINEL_PRIME/13_COMMAND_CENTER/api/health.json
SENTINEL_PRIME/13_COMMAND_CENTER/api/minimax-ecosystem.json
SENTINEL_PRIME/13_COMMAND_CENTER/api/sentinel-state.json
SENTINEL_PRIME/13_COMMAND_CENTER/api/state-history.jsonl
SENTINEL_PRIME/13_COMMAND_CENTER/api/deployment-tests.json
SENTINEL_PRIME/13_COMMAND_CENTER/api/last_test_run.json
SENTINEL_PRIME/13_COMMAND_CENTER/api/verify-report.json
SENTINEL_PRIME/13_COMMAND_CENTER/api/sentinel-cc.log
SENTINEL_PRIME/13_COMMAND_CENTER/api/sentinel-cc.err.log
SENTINEL_PRIME/13_COMMAND_CENTER/api/sentinel-cc.pid
SENTINEL_PRIME/08_SELF_IMPROVEMENT/backups/
SENTINEL_PRIME/08_SELF_IMPROVEMENT/backup_metadata/

